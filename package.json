  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/node": "^26.6.4",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo-mcp": "~0.2.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
