{
  "name": "protokit",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsHendri/protokit.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/mobile",
    "ios": "npm run ios -w apps/mobile",
    "web": "npm run web -w apps/mobile",
    "typecheck": "npm run typecheck -w apps/mobile",
    "lint": "npm run lint -w apps/mobile",
    "check": "npm run typecheck -w apps/mobile && npm run lint -w apps/mobile -- --max-warnings 0 && npm run tokens:check -w apps/mobile && npm run test:tokens -w apps/mobile && npm run registry:build -w apps/mobile -- --check"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.14"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
