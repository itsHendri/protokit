{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kit-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "exec",
        "-w",
        "apps/mobile",
        "--",
        "expo",
        "start",
        "--web",
        "--port",
        "8090"
      ],
      "port": 8090
    },
    {
      "name": "kit-ios",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "exec",
        "-w",
        "apps/mobile",
        "--",
        "expo",
        "start",
        "--ios",
        "--port",
        "8091"
      ],
      "port": 8091
    },
    {
      "name": "web-kit",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "apps/web"
      ],
      "port": 3100
    },
    {
      "name": "docs-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "apps/docs"
      ],
      "port": 3000
    },
    {
      "name": "docs-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "-w",
        "apps/docs"
      ],
      "port": 8788
    }
  ]
}
